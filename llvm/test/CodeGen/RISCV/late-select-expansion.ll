; LATE-NEXT:    sub a3, a3, a5
; LATE-NEXT:    bge a0, a1, .LBB4_2
; LATE-NEXT:  # %bb.1:
; LATE-NEXT:    add a3, a2, a4
; LATE-NEXT:  .LBB4_2:
; LATE-NEXT:    mv a0, a3
; LATE-NEXT:    ret
;
; VEER-LABEL: select_two_alu_ops:
; VEER:       # %bb.0:
