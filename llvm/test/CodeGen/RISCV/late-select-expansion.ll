; DEFAULT-NEXT:    sub a0, a3, a5
; DEFAULT-NEXT:    ret
; DEFAULT-NEXT:  .LBB4_2:
; DEFAULT-NEXT:    add a0, a2, a4
; DEFAULT-NEXT:    ret
;
; LATE-LABEL: select_two_alu_ops:
